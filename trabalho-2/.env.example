# Chaves dos provedores de LLM usados no modo `adversarial_validation` (ADR-003).
# A suíte padrão roda offline e NUNCA exige estas chaves (ADR-009).
# Copie para `.env` e preencha apenas o provedor que for usar; o `.env` real
# fica fora do versionamento (.gitignore) e a chave nunca vai ao frontend.

# Agno/Anthropic — provider padrão em `llm.provider` (config/scenarios.json)
ANTHROPIC_API_KEY=

# Agno/Groq — alternativa com plano gratuito (aula 10)
GROQ_API_KEY=
